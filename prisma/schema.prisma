// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CHAIR        // admin + sole approver
  DOCS
  CONTRIBUTOR
  VIEWER
}

model BudgetLine {
  id      String  @id @default(cuid())
  eventId String
  item    String
  amount  Decimal @db.Decimal(12, 2) // rupees, e.g. 1499.50
  notes   String?
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}


enum EventType {
  WORKSHOP
  SEMINAR
  FEST
  COMPETITION
  MEETING
  GUEST_LECTURE
  SOCIAL
  OTHER
}

enum EventStatus {
  PLANNED
  LIVE
  COMPLETED
  REPORTED
  ARCHIVED
}

model Chapter {
  id           String       @id @default(cuid())
  name         String
  parentBody   String       // "IEEE SIGHT", "CSI", "NSS", etc.
  academicYear String       // "2026-27"
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  events       Event[]
  templates    ChapterTemplate[]
}

model User {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  image     String?
  createdAt DateTime     @default(now())
  memberships Membership[]
  accounts  Account[]
  approvals Approval[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  chapterId String
  role      Role     @default(CONTRIBUTOR)
  termStart DateTime @default(now())
  termEnd   DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model Event {
  id          String        @id @default(cuid())
  chapterId   String
  title       String
  type        EventType
  startsAt    DateTime
  endsAt      DateTime
  venue       String?
  status      EventStatus   @default(PLANNED)
  objectives  String?
  outcomes    String?
  participantCount Int?
  tags        String[]      @default([])
  createdAt   DateTime      @default(now())
  chapter     Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  speakers    Speaker[]
  budgetLines BudgetLine[]
  documents   Document[]
  participants Participant[]
  mediaItems  MediaItem[]
  tasks       Task[]
  certificates Certificate[]

  @@index([chapterId, status])
  @@index([chapterId, startsAt])
}

model Speaker {
  id          String  @id @default(cuid())
  eventId     String
  name        String
  designation String?
  bio         String?
  photoKey    String?
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}


// --- Phase 2+ entities (schema only for now) ---

model ChapterTemplate {
  id        String @id @default(cuid())
  chapterId String
  type      String  // "proposal", "permission_letter", ...
  body      Json    // template definition
  isDefault Boolean @default(false)
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model Document {
  id               String  @id @default(cuid())
  eventId          String
  type             String
  currentVersionId String? // resolved after versions exist
  event            Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions         DocumentVersion[]
}

model Approval {
  id          String     @id @default(cuid())
  versionId   String
  approverId  String
  decision    ApprovalDecision
  comment     String?
  decidedAt  DateTime   @default(now())
  sequence    Int        // Which step in the approval chain (0-indexed)
  version     DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  approver    User       @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([versionId, sequence])
}

model Participant {
  id       String  @id @default(cuid())
  eventId  String
  name     String
  email    String?
  attended Boolean @default(false)
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Certificate {
  id            String      @id @default(cuid())
  eventId       String
  participantId String?
  serial        String      @unique
  fileKey       String?
  issuedAt      DateTime    @default(now())
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model MediaItem {
  id         String  @id @default(cuid())
  eventId    String
  fileKey    String
  caption    String?
  consentFlag Boolean @default(false)
  uploadedBy String
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(cuid())
  eventId     String
  assigneeId  String
  description String
  dueAt       DateTime?
  status      String   @default("TODO")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model ActionItem {
  id          String    @id @default(cuid())
  meetingId   String
  ownerId     String
  description String
  dueAt       DateTime?
  status      String    @default("OPEN")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  metadata  Json?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Add these to schema.prisma (if not already there)


enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  PENDING
}

model DocumentVersion {
  id         String     @id @default(cuid())
  documentId String
  fileKey    String
  generatedAt DateTime   @default(now())
  createdBy  String
  status     DocumentStatus @default(DRAFT)
  approvals  Approval[]
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, generatedAt])
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  CHANGES_REQUESTED
  ARCHIVED
}
